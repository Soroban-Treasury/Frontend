# Everything here is optional. With no settings the app runs on testnet.

# testnet (default) or mainnet. Sets the passphrase, a public RPC and the explorer links.
# NEXT_PUBLIC_NETWORK=testnet

# Your own Soroban RPC. Recommended for mainnet.
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Only for a custom network, such as a local one (then also set NEXT_PUBLIC_RPC_URL).
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Hash of treasury contract code already on the network. Leave empty to use the code bundled in
# public/contract/, which the app uploads first on a network that does not have it.
# NEXT_PUBLIC_WASM_HASH=

# URL of treasury-api. Adds the activity log. Add this app's origin to the API's CORS_ORIGIN.
# NEXT_PUBLIC_API_URL=http://localhost:3000

# The sub-path the site is served from, for example /Frontend on GitHub Pages.
# NEXT_PUBLIC_BASE_PATH=
