# Soroban RPC and network. Defaults are testnet. For mainnet use your RPC provider URL and
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Hex hash of the uploaded treasury contract wasm. Needed to create treasuries from the app.
NEXT_PUBLIC_WASM_HASH=

# Optional: URL of treasury-api. Adds the audit log to the history view.
NEXT_PUBLIC_API_URL=
